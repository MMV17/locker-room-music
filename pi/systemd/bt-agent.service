[Unit]
Description=Bluetooth auto-accept pairing agent (NoInputNoOutput)
After=bluetooth.service
Requires=bluetooth.service
# No start rate limit. The default (5 starts in 10s) turns a few fast failures
# into a unit systemd refuses to start again until someone runs reset-failed -
# and nobody can, on a box with no way in. Restart= below keeps trying for ever
# instead. In [Unit], not [Service]: it is silently ignored under [Service].
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/usr/bin/bt-agent -c NoInputNoOutput
Restart=always
RestartSec=2
# bt-agent ignores SIGTERM, so every stop sat out systemd's default 90s before
# the SIGKILL (seen in every repair log: "State 'stop-sigterm' timed out").
# It holds no state worth a graceful exit - it re-registers as the agent on
# start - so give it 5s, not 90.
TimeoutStopSec=5

[Install]
WantedBy=multi-user.target
