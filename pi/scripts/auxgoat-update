#!/usr/bin/python3
"""Over-the-air updates for the AuxGoat listener, with automatic rollback.

    auxgoat-update request            # fetch, check, schedule a detached apply
    auxgoat-update apply --commit SHA # stage, gate, flip, restart, hand to verify
    auxgoat-update verify             # commit or roll back the release on trial
    auxgoat-update recover            # boot: finish or revert an interrupted update
    auxgoat-update status             # what is installed and what happened last
    auxgoat-update adopt --commit SHA # a cable/serial deploy just replaced the code

WHY THIS EXISTS. The box sits on a network that allows outbound 443 and nothing
else, so the listener is the only way in - and until this script, changing the
listener needed a cable. The listener IS the control channel, so an updater
that can strand it is worse than no updater. Everything here is shaped by that:

  * A release is an immutable directory, /opt/lockerroom/releases/<id>/. The
    live package /opt/lockerroom/lockerroom is a SYMLINK into one of them, so
    switching and switching back are each a single rename(2). There is no
    moment when the package is half old and half new.
  * New code is on TRIAL until it proves itself: the listener writes
    /run/lockerroom/health.json (only new code does), and `verify` commits
    only when that marker names this release, this boot and the unit's own
    PID and shows two good beacons. A crash rolls back in seconds. A listener
    that runs but cannot beacon while the network is demonstrably up rolls
    back. A network outage is neither: the trial simply waits.
  * The way back is created BEFORE the switch (lockerroom.rollback), so
    rolling back needs no free disk space.
  * State is journaled before every step and `recover` runs on every boot,
    ahead of the listener, so a power cut at any point lands on a complete,
    verified package.
  * Scripts and units are synced only AFTER the listener trial commits. The
    listener and the repair hatch that would rescue it never change in the
    same step. lockerroom-listener.service itself and the bluealsa-aplay
    drop-in are never touched from here.

Standard library only, and run by the SYSTEM python3: it must keep working
when the listener's venv or code is the thing that is broken.
"""

from __future__ import annotations

import argparse
import fcntl
import hashlib
import io
import json
import os
import pwd
import re
import shutil
import signal
import subprocess
import sys
import tarfile
import time
import uuid
from datetime import datetime, timezone
from pathlib import Path

E = os.environ.get

# Every path is overridable ONLY so the tests can drive this real script
# against a throwaway directory. Nothing sets these in production: the
# listener runs `sudo auxgoat-update request` as a fixed argv (sudo resets the
# environment) and the systemd units carry no Environment=.
ROOT = Path(E("AUXGOAT_ROOT", "/opt/lockerroom"))
REPO = Path(E("AUXGOAT_REPO", str(ROOT / "repo")))
RUN = Path(E("AUXGOAT_RUN", "/run/lockerroom"))
ETC = Path(E("AUXGOAT_ETC", "/etc/lockerroom"))
BIN_DIR = Path(E("AUXGOAT_BIN_DIR", "/usr/local/bin"))
UNIT_DIR = Path(E("AUXGOAT_UNIT_DIR", "/etc/systemd/system"))
UDEV_DIR = Path(E("AUXGOAT_UDEV_DIR", "/etc/udev/rules.d"))
ASOUND = Path(E("AUXGOAT_ASOUND", "/proc/asound"))
VENV_PY = E("AUXGOAT_VENV_PY", str(ROOT / "venv/bin/python"))
SYS_PY = E("AUXGOAT_SYS_PY", "/usr/bin/python3")
BOOT_ID_FILE = Path(E("AUXGOAT_BOOT_ID_FILE", "/proc/sys/kernel/random/boot_id"))
SELF = E("AUXGOAT_SELF", "/usr/local/bin/auxgoat-update")

PKG = ROOT / "lockerroom"
RELEASES = ROOT / "releases"
UPDATE = ROOT / "update"
STATE = UPDATE / "state.json"
RESULT = UPDATE / "last-result.json"
