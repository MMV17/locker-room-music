.DS_Store
.venv/
__pycache__/
*.pyc
.pytest_cache/
config.toml

# local dev secrets
backend/.dev.vars
# production secrets, kept only so they can be retrieved — Cloudflare secrets
# are write-only. MAC_SALT especially: changing it orphans every device row.
backend/.secrets.local
backend/node_modules/
backend/.wrangler/
# Wrangler's local cache — machine state, not source. It also carries the
# Cloudflare account id and account name, which do not belong in git.
.wrangler/

# The frontend build output. Source lives in web/; this is where `npm run
# build` in web/ writes, and where the Worker's [assets] binding reads from.
backend/public/
web/node_modules/
web/dist/

# The apex Worker. Note apex/public/ is NOT ignored, unlike backend/public/:
# it holds one vendored font and no build output, so the Worker deploys from a
# clean checkout with no build step.
apex/node_modules/
apex/.wrangler/
