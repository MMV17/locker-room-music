#encoding utf-8
#
# AUXGOAT_PWR
#
DEF AUXGOAT_PWR B 0 40 Y Y 1 F N
F0 "B" -700 250 50 H V L CNN
F1 "AUXGOAT_PWR" -700 -300 50 H V L CNN
F2 "" 0 0 50 H I C CNN
F3 "" 0 0 50 H I C CNN
DRAW
S -700 200 700 -200 0 1 10 f
X GND 1 -1000 100 300 R 50 50 1 1 W
X +5V 2 -1000 0 300 R 50 50 1 1 W
X +3V3_A 3 -1000 -100 300 R 50 50 1 1 W
ENDDRAW
ENDDEF
